{
  "name": "nudgling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "integrations": "tsx --env-file=.env src/scripts/integrations.ts",
    "test": "tsx --test test/*.test.ts",
    "nudge": "tsx --env-file-if-exists=.env src/surfaces/cli.ts run",
    "demo": "tsx src/surfaces/cli.ts demo",
    "demo:live": "tsx --env-file-if-exists=.env src/scripts/live-demo.ts",
    "status": "tsx src/surfaces/cli.ts status",
    "render": "tsx src/surfaces/cli.ts render"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.97",
    "@composio/core": "^0.25.0",
    "@composio/vercel": "^0.12.1",
    "@hono/node-server": "^2.1.5",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^7.0.144",
    "hono": "^4.13.13",
    "parallel-web": "^1.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
