{
  "name": "nudgling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "integrations": "tsx --env-file=.env src/scripts/integrations.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.97",
    "@composio/core": "^0.25.0",
    "@composio/vercel": "^0.12.1",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.144",
    "hono": "^4.13.13",
    "parallel-web": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
