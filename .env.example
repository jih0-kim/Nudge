PORT=3000

# SQLite: keep this file on persistent disk; do not commit or publicly serve it.
DATABASE_PATH=data/nudge.sqlite

# Optional deployment URL. The setup page also detects its public HTTPS origin.
APP_BASE_URL=
# Optional private installer key; otherwise generated and stored in SQLite.
NUDGE_SETUP_TOKEN=

# OpenAI: required only for AI features (model override is optional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Composio: workspace installation owner (not an individual Slack chat user's ID).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=local-user
# For a branded Slack app: custom Slackbot OAuth configuration created in Composio.
COMPOSIO_SLACK_AUTH_CONFIG_ID=

# Personal connected apps (/apps). Also requires APP_BASE_URL to be public HTTPS.
# Create OAuth auth configs in Composio and review their scopes before enabling.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GOOGLECALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GITHUB_AUTH_CONFIG_ID=

# Parallel: required only for web search.
PARALLEL_API_KEY=
